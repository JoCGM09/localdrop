---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LocalDrop">
	<div class="bg-bg-secondary rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col mt-8 max-w-xl mx-auto w-full">
		<!-- Tabs -->
		<div class="flex border-b border-slate-200">
			<button 
				id="tab-send"
				class="flex-1 py-4 text-center font-medium transition-colors bg-white text-primary border-b-2 border-primary"
			>
				Enviar
			</button>
			<button 
				id="tab-receive"
				class="flex-1 py-4 text-center font-medium transition-colors text-text-secondary hover:bg-slate-50 border-b-2 border-transparent"
			>
				Recibir
			</button>
		</div>

		<div class="p-6 md:p-8">
			<!-- Vista Enviar -->
			<div id="view-send" class="block">
				<!-- Estado: Formulario Inicial -->
				<div id="send-state-initial" class="space-y-4 block">
					<!-- Tabs Tipo de Envío -->
					<div class="flex bg-slate-100 rounded-md p-1 mb-4">
						<button id="send-type-text" class="flex-1 py-1.5 text-sm font-medium rounded bg-white shadow-sm text-text-main transition-all">Texto</button>
						<button id="send-type-file" class="flex-1 py-1.5 text-sm font-medium rounded text-text-secondary hover:text-text-main transition-all">Archivo</button>
						<button id="send-type-image" class="flex-1 py-1.5 text-sm font-medium rounded text-text-secondary hover:text-text-main transition-all">Imagen</button>
					</div>

					<!-- Contenedor Texto -->
					<div id="text-container" class="space-y-2 block">
						<label for="text-to-send" class="block font-medium">Texto a enviar</label>
						<textarea 
							id="text-to-send" 
							rows="6" 
							class="flex min-h-[120px] w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none"
							placeholder="Escribe o pega tu texto aquí..."
						></textarea>
					</div>

					<!-- Contenedor Archivo (Dropzone) -->
					<div id="file-container" class="hidden space-y-2">
						<label class="block font-medium">Archivo a enviar (Max 50MB)</label>
						
						<!-- Dropzone Area -->
						<div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-lg p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-slate-50 hover:border-primary transition-colors">
							<svg class="h-10 w-10 text-slate-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
							</svg>
							<p class="text-sm font-medium text-text-main">Haz clic para seleccionar o arrastra un archivo aquí</p>
							<p class="text-xs text-slate-500 mt-1">Soporta cualquier archivo (ej. PDF, JPG, ZIP)</p>
							<input type="file" id="file-input" class="hidden" accept="*" />
						</div>

						<!-- File Preview (Hidden by default) -->
						<div id="file-preview-container" class="hidden border border-slate-200 rounded-lg p-4 flex items-center justify-between bg-slate-50">
							<div class="flex items-center gap-3 overflow-hidden">
								<svg class="h-8 w-8 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
								</svg>
								<div class="min-w-0">
									<p id="file-name" class="text-sm font-medium text-text-main truncate">documento.pdf</p>
									<p id="file-size" class="text-xs text-slate-500">2.4 MB</p>
								</div>
							</div>
							<button id="btn-remove-file" class="text-slate-400 hover:text-error p-1 rounded transition-colors" title="Quitar archivo">
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
							</button>
						</div>
					</div>

					<!-- Contenedor Imagen (Portapapeles) -->
					<div id="image-container" class="hidden space-y-2">
						<label class="block font-medium">Pegar Imagen (Ctrl+V)</label>
						
						<!-- Dropzone Area para Imagen -->
						<div id="image-dropzone" class="border-2 border-dashed border-slate-300 rounded-lg p-8 flex flex-col items-center justify-center text-center hover:bg-slate-50 transition-colors h-48 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" tabindex="0">
							<svg class="h-10 w-10 text-slate-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
							</svg>
							<p class="text-sm font-medium text-text-main">Haz clic aquí y presiona Ctrl+V</p>
							<p class="text-xs text-slate-500 mt-1">Pega una imagen directamente desde tu portapapeles</p>
						</div>

						<!-- Image Preview (Hidden by default) -->
						<div id="image-preview-container" class="hidden relative border border-slate-200 rounded-lg overflow-hidden bg-slate-50 flex items-center justify-center h-48">
							<img id="image-preview-element" class="max-h-full max-w-full object-contain" src="" alt="Preview de la imagen" />
							<button id="btn-remove-image" class="absolute top-2 right-2 bg-white/90 shadow-sm text-slate-500 hover:text-error p-1.5 rounded-full transition-colors backdrop-blur-sm" title="Quitar imagen">
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
							</button>
						</div>
					</div>

					<button 
						id="btn-generate-pin"
						class="inline-flex w-full items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-blue-900 h-11 px-8"
					>
						Generar PIN
					</button>
				</div>

				<!-- Estado: Esperando Receptor -->
				<div id="send-state-waiting" class="hidden flex-col items-center justify-center py-6 text-center space-y-4">
					<p class="font-medium text-text-secondary">Código de seguridad</p>
					<div id="display-pin" class="text-6xl font-bold font-mono text-primary tracking-widest">----</div>
					<div class="flex items-center justify-center text-sm text-text-secondary gap-2 mt-4">
						<svg class="animate-spin h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
						Esperando al receptor...
					</div>
					<p class="text-xs text-text-secondary">Expira en 5 minutos</p>
					<button id="btn-cancel-send" class="mt-4 text-text-secondary text-sm hover:underline">Cancelar</button>
				</div>

				<!-- Estado: Transferencia Exitosa -->
				<div id="send-state-success" class="hidden flex-col items-center justify-center py-6 text-center space-y-4">
					<div class="h-16 w-16 bg-green-100 rounded-full flex items-center justify-center text-success mb-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
					</div>
					<h3 class="text-xl font-bold text-success">¡Transferencia completada!</h3>
					<p class="text-text-secondary">El texto ha sido recibido y borrado de la memoria.</p>
					<button id="btn-send-another" class="mt-6 w-full inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 h-11 px-8 text-primary">Enviar otro texto/archivo</button>
				</div>
			</div>

			<!-- Vista Recibir (Oculta inicialmente) -->
			<div id="view-receive" class="hidden">
				<!-- Estado: Ingresar PIN -->
				<div id="receive-state-initial" class="space-y-6 text-center block">
					<p class="font-medium text-text-secondary">Ingresa el código PIN para recibir el texto</p>
					<div class="flex justify-center gap-3 my-4">
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-200 bg-white rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors disabled:cursor-not-allowed disabled:opacity-50" />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-200 bg-white rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors disabled:cursor-not-allowed disabled:opacity-50" disabled />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-200 bg-white rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors disabled:cursor-not-allowed disabled:opacity-50" disabled />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-200 bg-white rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors disabled:cursor-not-allowed disabled:opacity-50" disabled />
					</div>
					<button 
						id="btn-receive-text"
						class="inline-flex w-full items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-blue-900 h-11 px-8"
						disabled
					>
						Recibir
					</button>
				</div>

				<!-- Estado: Texto Recibido -->
				<div id="receive-state-success" class="hidden flex-col space-y-4">
					<div class="flex items-center gap-2 text-success mb-2">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="font-medium">Texto recibido exitosamente</span>
					</div>
					<div class="relative">
						<textarea 
							id="received-text" 
							readonly
							rows="6" 
							class="flex min-h-[120px] w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-none text-text-main"
						></textarea>
					</div>
					<div class="flex gap-3 pt-2">
						<button 
							id="btn-copy-text"
							class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-blue-900 h-10 px-4 py-2 gap-2"
						>
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
							Copiar texto
						</button>
						<button id="btn-receive-another" class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 h-10 px-4 py-2">Volver</button>
					</div>
				</div>

				<!-- Estado: Archivo Recibido -->
				<div id="receive-state-file-success" class="hidden flex-col space-y-4">
					<div class="flex items-center gap-2 text-success mb-2">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="font-medium">Archivo listo para descargar</span>
					</div>
					<div class="border border-slate-200 rounded-lg p-4 flex items-center justify-between bg-white shadow-sm">
						<div class="flex items-center gap-3 overflow-hidden">
							<svg class="h-8 w-8 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
							</svg>
							<div class="min-w-0">
								<p id="received-file-name" class="text-sm font-medium text-text-main truncate">documento.pdf</p>
							</div>
						</div>
					</div>
					<div class="flex gap-3 pt-2">
						<button 
							id="btn-download-file"
							class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-blue-900 h-10 px-4 py-2 gap-2"
						>
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
							Descargar
						</button>
						<button id="btn-receive-another-file" class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 h-10 px-4 py-2">Volver</button>
					</div>
				</div>

				<!-- Estado: Imagen Recibida -->
				<div id="receive-state-image-success" class="hidden flex-col space-y-4">
					<div class="flex items-center gap-2 text-success mb-2">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="font-medium">Imagen recibida exitosamente</span>
					</div>
					<div class="relative border border-slate-200 rounded-lg overflow-hidden bg-slate-50 flex items-center justify-center min-h-[200px] max-h-[300px]">
						<img id="received-image-element" class="max-h-full max-w-full object-contain" src="" alt="Imagen recibida" />
					</div>
					<div class="flex flex-col gap-3 pt-2">
						<div class="flex gap-3">
							<button 
								id="btn-copy-image"
								class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-white hover:bg-blue-900 h-10 px-4 py-2 gap-2"
							>
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
								Copiar
							</button>
							<button 
								id="btn-download-image"
								class="flex-1 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 h-10 px-4 py-2 gap-2"
							>
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
								Descargar
							</button>
						</div>
						<button id="btn-receive-another-image" class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border border-slate-200 bg-white hover:bg-slate-100 hover:text-slate-900 h-10 px-4 py-2">Volver</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	// ---------------------------------------------------------
	// 1. LÓGICA DE TABS (UI BASE)
	// ---------------------------------------------------------
	const tabSend = document.getElementById('tab-send');
	const tabReceive = document.getElementById('tab-receive');
	const viewSend = document.getElementById('view-send');
	const viewReceive = document.getElementById('view-receive');

	const setSendActive = () => {
		tabSend?.classList.add('bg-white', 'text-primary', 'border-primary');
		tabSend?.classList.remove('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		tabReceive?.classList.remove('bg-white', 'text-primary', 'border-primary');
		tabReceive?.classList.add('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		viewSend?.classList.remove('hidden');
		viewSend?.classList.add('block');
		
		viewReceive?.classList.add('hidden');
		viewReceive?.classList.remove('block');
	};

	const setReceiveActive = () => {
		tabReceive?.classList.add('bg-white', 'text-primary', 'border-primary');
		tabReceive?.classList.remove('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		tabSend?.classList.remove('bg-white', 'text-primary', 'border-primary');
		tabSend?.classList.add('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		viewReceive?.classList.remove('hidden');
		viewReceive?.classList.add('block');
		
		viewSend?.classList.add('hidden');
		viewSend?.classList.remove('block');
	};

	tabSend?.addEventListener('click', setSendActive);
	tabReceive?.addEventListener('click', setReceiveActive);

	// ---------------------------------------------------------
	// 2. LÓGICA DE WEBSOCKETS (VISTA ENVIAR)
	// ---------------------------------------------------------
	
	// Elementos UI de "Enviar"
	const stateInitial = document.getElementById('send-state-initial');
	const stateWaiting = document.getElementById('send-state-waiting');
	const stateSuccess = document.getElementById('send-state-success');
	
	const txtToSend = document.getElementById('text-to-send') as HTMLTextAreaElement;
	const btnGeneratePin = document.getElementById('btn-generate-pin') as HTMLButtonElement;
	const displayPin = document.getElementById('display-pin');
	
	const btnCancelSend = document.getElementById('btn-cancel-send');
	const btnSendAnother = document.getElementById('btn-send-another');

	// Elementos UI Tipo de Envío (Tabs internos)
	const btnSendTypeText = document.getElementById('send-type-text');
	const btnSendTypeFile = document.getElementById('send-type-file');
	const btnSendTypeImage = document.getElementById('send-type-image');
	const containerText = document.getElementById('text-container');
	const containerFile = document.getElementById('file-container');
	const containerImage = document.getElementById('image-container');
	
	// Elementos UI Dropzone
	const dropzone = document.getElementById('dropzone');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;
	const filePreviewContainer = document.getElementById('file-preview-container');
	const lblFileName = document.getElementById('file-name');
	const lblFileSize = document.getElementById('file-size');
	const btnRemoveFile = document.getElementById('btn-remove-file');

	// Elementos UI Imagen (Portapapeles)
	const imageDropzone = document.getElementById('image-dropzone');
	const imagePreviewContainer = document.getElementById('image-preview-container');
	const imagePreviewElement = document.getElementById('image-preview-element') as HTMLImageElement;
	const btnRemoveImage = document.getElementById('btn-remove-image');

	let ws: WebSocket | null = null;
	let currentSendMode: 'text' | 'file' | 'image' = 'text';
	let selectedFile: File | null = null;
	let selectedImageFile: File | null = null;
	let selectedImageBlobUrl: string = '';
	const MAX_FILE_SIZE = 50 * 1024 * 1024; // 50MB

	// Utilidad para transiciones suaves
	const transitionState = (hideElements: (HTMLElement | null)[], showElements: (HTMLElement | null)[], displayClass: string = 'block') => {
		hideElements.forEach(el => {
			if (!el) return;
			el.classList.add('opacity-0', 'transition-opacity', 'duration-200');
			setTimeout(() => {
				el.classList.add('hidden');
				el.classList.remove('block', 'flex');
				el.classList.remove('opacity-0', 'transition-opacity', 'duration-200');
			}, 200);
		});

		setTimeout(() => {
			showElements.forEach(el => {
				if (!el) return;
				el.classList.remove('hidden');
				el.classList.add(displayClass);
				el.classList.add('opacity-0', 'transition-opacity', 'duration-200');
				// Force reflow
				void el.offsetWidth;
				el.classList.remove('opacity-0');
				el.classList.add('opacity-100');
			});
		}, 200);
	};

	// --- Lógica de Tabs internos ---
	const updateTabUI = (activeBtn: HTMLElement | null, inactiveBtns: (HTMLElement | null)[]) => {
		activeBtn?.classList.replace('text-text-secondary', 'text-text-main');
		activeBtn?.classList.replace('hover:text-text-main', 'bg-white');
		activeBtn?.classList.add('shadow-sm');

		inactiveBtns.forEach(btn => {
			btn?.classList.replace('text-text-main', 'text-text-secondary');
			btn?.classList.replace('bg-white', 'hover:text-text-main');
			btn?.classList.remove('shadow-sm');
		});
	};

	btnSendTypeText?.addEventListener('click', () => {
		currentSendMode = 'text';
		updateTabUI(btnSendTypeText, [btnSendTypeFile, btnSendTypeImage]);

		containerText?.classList.replace('hidden', 'block');
		containerFile?.classList.replace('block', 'hidden');
		containerImage?.classList.replace('block', 'hidden');
	});

	btnSendTypeFile?.addEventListener('click', () => {
		currentSendMode = 'file';
		updateTabUI(btnSendTypeFile, [btnSendTypeText, btnSendTypeImage]);

		containerFile?.classList.replace('hidden', 'block');
		containerText?.classList.replace('block', 'hidden');
		containerImage?.classList.replace('block', 'hidden');
	});

	btnSendTypeImage?.addEventListener('click', () => {
		currentSendMode = 'image';
		updateTabUI(btnSendTypeImage, [btnSendTypeText, btnSendTypeFile]);

		containerImage?.classList.replace('hidden', 'block');
		containerText?.classList.replace('block', 'hidden');
		containerFile?.classList.replace('block', 'hidden');
		
		// Dar foco automático al área de pegado de imagen
		const imgDropzone = document.getElementById('image-dropzone');
		if (imgDropzone) setTimeout(() => imgDropzone.focus(), 50);
	});

	// --- Lógica Dropzone y Archivos ---
	const formatBytes = (bytes: number, decimals = 2) => {
		if (!+bytes) return '0 Bytes';
		const k = 1024;
		const dm = decimals < 0 ? 0 : decimals;
		const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
	};

	const handleImageSelection = (file: File) => {
		if (file.size > MAX_FILE_SIZE) {
			window.showToast(`La imagen es muy grande (${formatBytes(file.size)}). El máximo es 50MB.`, 'error');
			return;
		}
		
		// Liberar URL previa si existiera
		if (selectedImageBlobUrl) {
			URL.revokeObjectURL(selectedImageBlobUrl);
		}

		selectedImageFile = file;
		selectedImageBlobUrl = URL.createObjectURL(file);
		
		if (imagePreviewElement) imagePreviewElement.src = selectedImageBlobUrl;
		
		imageDropzone?.classList.replace('flex', 'hidden');
		imagePreviewContainer?.classList.replace('hidden', 'flex');
	};

	const handleFileSelection = (file: File) => {
		if (file.size > MAX_FILE_SIZE) {
			window.showToast(`El archivo es muy grande (${formatBytes(file.size)}). El máximo es 50MB.`, 'error');
			return;
		}
		selectedFile = file;
		if (lblFileName) lblFileName.textContent = file.name;
		if (lblFileSize) lblFileSize.textContent = formatBytes(file.size);
		
		dropzone?.classList.replace('flex', 'hidden');
		filePreviewContainer?.classList.replace('hidden', 'flex');
	};

	const removeFile = () => {
		selectedFile = null;
		if (fileInput) fileInput.value = '';
		filePreviewContainer?.classList.replace('flex', 'hidden');
		dropzone?.classList.replace('hidden', 'flex');
	};

	const removeImage = () => {
		selectedImageFile = null;
		if (selectedImageBlobUrl) {
			URL.revokeObjectURL(selectedImageBlobUrl);
			selectedImageBlobUrl = '';
		}
		if (imagePreviewElement) imagePreviewElement.src = '';
		
		imagePreviewContainer?.classList.replace('flex', 'hidden');
		imageDropzone?.classList.replace('hidden', 'flex');
		imageDropzone?.focus();
	};

	dropzone?.addEventListener('click', () => fileInput?.click());
	btnRemoveFile?.addEventListener('click', removeFile);
	btnRemoveImage?.addEventListener('click', removeImage);

	fileInput?.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		if (target.files && target.files.length > 0) {
			handleFileSelection(target.files[0]);
		}
	});

	// Drag & Drop
	['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
		dropzone?.addEventListener(eventName, (e) => {
			e.preventDefault();
			e.stopPropagation();
		});
	});

	['dragenter', 'dragover'].forEach(eventName => {
		dropzone?.addEventListener(eventName, () => {
			dropzone?.classList.add('border-primary', 'bg-slate-50');
		});
	});

	['dragleave', 'drop'].forEach(eventName => {
		dropzone?.addEventListener(eventName, () => {
			dropzone?.classList.remove('border-primary', 'bg-slate-50');
		});
	});

	dropzone?.addEventListener('drop', (e: DragEvent) => {
		if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
			handleFileSelection(e.dataTransfer.files[0]);
		}
	});

	// Paste support anywhere in the window
	window.addEventListener('paste', (e: ClipboardEvent) => {
		// Solo capturar si el form inicial está visible
		if (!stateInitial?.classList.contains('block') || !e.clipboardData) return;
		
		const items = e.clipboardData.items;
		
		// Manejar pegado en modo Imagen
		if (currentSendMode === 'image') {
			for (let i = 0; i < items.length; i++) {
				if (items[i].type.indexOf('image') !== -1) {
					const file = items[i].getAsFile();
					if (file) handleImageSelection(file);
					return; // Stop after first image
				}
			}
			window.showToast('No se detectó ninguna imagen en el portapapeles', 'error');
		} 
		// Manejar pegado en modo Archivo (mantenemos retrocompatibilidad)
		else if (currentSendMode === 'file') {
			if (e.clipboardData.files && e.clipboardData.files.length > 0) {
				handleFileSelection(e.clipboardData.files[0]);
			}
		}
	});

	// --- Flujo Principal de Envío ---
	const resetSendView = () => {
		if (ws) {
			ws.close();
			ws = null;
		}
		txtToSend.value = '';
		removeFile();
		removeImage();
		btnGeneratePin.disabled = false;
		
		transitionState([stateWaiting, stateSuccess], [stateInitial], 'block');
	};

	const showWaitingState = (pin: string) => {
		if(displayPin) displayPin.textContent = pin;
		transitionState([stateInitial], [stateWaiting], 'flex');
	};

	const showSuccessState = () => {
		if (ws) {
			ws.close();
			ws = null;
		}
		transitionState([stateWaiting], [stateSuccess], 'flex');
	};

	const showError = (msg: string) => {
		window.showToast(msg, 'error');
		btnGeneratePin.disabled = false;
	};

	btnGeneratePin?.addEventListener('click', () => {
		if (currentSendMode === 'text') {
			const text = txtToSend.value.trim();
			if (!text) {
				showError('El texto no puede estar vacío');
				return;
			}
		} else if (currentSendMode === 'file') {
			if (!selectedFile) {
				showError('Debes seleccionar un archivo primero');
				return;
			}
		} else if (currentSendMode === 'image') {
			if (!selectedImageFile) {
				showError('Debes pegar una imagen primero (Ctrl+V)');
				return;
			}
		}

		btnGeneratePin.disabled = true;

		// Conectar al WebSocket proxificado por Vite/Astro para evitar problemas con Ngrok
		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const host = window.location.host; // Usa el host actual (ej. de ngrok)
		ws = new WebSocket(`${protocol}//${host}/ws`);
		ws.binaryType = 'arraybuffer'; // Importante para enviar archivos

		ws.onopen = () => {
			if (currentSendMode === 'text') {
				ws?.send(JSON.stringify({
					action: 'send_text',
					payload: txtToSend.value.trim()
				}));
			} else if (currentSendMode === 'file' && selectedFile) {
				ws?.send(JSON.stringify({
					action: 'send_file',
					filename: selectedFile.name
				}));
			} else if (currentSendMode === 'image' && selectedImageFile) {
				// Generamos un nombre genérico con la extensión inferida del type (ej. image/png -> .png)
				const ext = selectedImageFile.type.split('/')[1] || 'png';
				ws?.send(JSON.stringify({
					action: 'send_file',
					filename: `clipboard-image.${ext}`
				}));
			}
		};

		ws.onmessage = (event) => {
			try {
				const data = JSON.parse(event.data);
				
				if (data.action === 'ready_for_binary') {
					// El servidor está listo para recibir el archivo binario
					if (currentSendMode === 'file' && selectedFile && ws) {
						ws.send(selectedFile);
					} else if (currentSendMode === 'image' && selectedImageFile && ws) {
						ws.send(selectedImageFile);
					}
				} else if (data.action === 'pin_generated') {
					showWaitingState(data.pin);
				} else if (data.action === 'transfer_complete') {
					showSuccessState();
					window.showToast('¡El receptor descargó el archivo con éxito!');
				} else if (data.action === 'error') {
					showError(data.message || 'Error desconocido');
					resetSendView();
				}
			} catch (e) {
				console.error("Error parseando mensaje WS", e);
			}
		};

		ws.onerror = (error) => {
			console.error("WebSocket Error:", error);
			showError('No se pudo conectar al servidor local.');
			resetSendView();
		};
	});

	btnCancelSend?.addEventListener('click', resetSendView);
	btnSendAnother?.addEventListener('click', resetSendView);

	// ---------------------------------------------------------
	// 3. LÓGICA DE WEBSOCKETS (VISTA RECIBIR)
	// ---------------------------------------------------------
	const recStateInitial = document.getElementById('receive-state-initial');
	const recStateSuccess = document.getElementById('receive-state-success');
	const pinInputs = document.querySelectorAll('.pin-input') as NodeListOf<HTMLInputElement>;
	const btnReceive = document.getElementById('btn-receive-text') as HTMLButtonElement;
	const txtReceived = document.getElementById('received-text') as HTMLTextAreaElement;
	const btnCopy = document.getElementById('btn-copy-text') as HTMLButtonElement;
	const btnRecAnother = document.getElementById('btn-receive-another');
	
	// Elementos para Archivos e Imágenes
	const recStateFileSuccess = document.getElementById('receive-state-file-success');
	const lblReceivedFileName = document.getElementById('received-file-name');
	const btnDownloadFile = document.getElementById('btn-download-file');
	const btnRecAnotherFile = document.getElementById('btn-receive-another-file');

	const recStateImageSuccess = document.getElementById('receive-state-image-success');
	const receivedImageElement = document.getElementById('received-image-element') as HTMLImageElement;
	const btnCopyImage = document.getElementById('btn-copy-image');
	const btnDownloadImage = document.getElementById('btn-download-image');
	const btnRecAnotherImage = document.getElementById('btn-receive-another-image');

	let recWs: WebSocket | null = null;
	let incomingFileName = '';
	let incomingFileBlobUrl = '';
	let incomingFileIsImage = false;
	
	// Auto-focus logic for PIN inputs
	pinInputs.forEach((input, index) => {
		input.addEventListener('input', (e) => {
			const val = (e.target as HTMLInputElement).value;
			// Solo permitir números
			if (!/^\d*$/.test(val)) {
				input.value = '';
				return;
			}
			if (val && index < pinInputs.length - 1) {
				pinInputs[index + 1].disabled = false;
				pinInputs[index + 1].focus();
			}
			checkPinComplete();
		});
		
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Backspace' && !input.value && index > 0) {
				pinInputs[index - 1].focus();
				pinInputs[index - 1].value = '';
				checkPinComplete();
			}
		});
	});

	const checkPinComplete = () => {
		const pin = Array.from(pinInputs).map(i => i.value).join('');
		if (btnReceive) btnReceive.disabled = pin.length !== 4;
	};

	const resetReceiveView = () => {
		if (recWs) {
			recWs.close();
			recWs = null;
		}
		pinInputs.forEach((i, idx) => {
			i.value = '';
			i.disabled = idx !== 0;
		});
		if (txtReceived) txtReceived.value = '';
		if (btnCopy) btnCopy.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg> Copiar texto';
		
		// Reset File states
		if (incomingFileBlobUrl) {
			URL.revokeObjectURL(incomingFileBlobUrl);
			incomingFileBlobUrl = '';
		}
		if (receivedImageElement) receivedImageElement.src = '';
		incomingFileName = '';
		incomingFileIsImage = false;

		checkPinComplete();
		
		transitionState([recStateSuccess, recStateFileSuccess, recStateImageSuccess], [recStateInitial], 'block');
		setTimeout(() => {
			pinInputs[0]?.focus();
		}, 300); // Dar tiempo a la transición para enfocar
	};

	btnReceive?.addEventListener('click', () => {
		const pin = Array.from(pinInputs).map(i => i.value).join('');
		if (pin.length !== 4) return;
		
		btnReceive.disabled = true;
		
		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const host = window.location.host;
		recWs = new WebSocket(`${protocol}//${host}/ws`);
		recWs.binaryType = 'blob'; // Prepara para recibir archivos
		
		recWs.onopen = () => {
			recWs?.send(JSON.stringify({
				action: 'receive_text',
				pin: pin
			}));
		};
		
		recWs.onmessage = (event) => {
			// Manejar recepción de Binarios (Archivos/Imágenes)
			if (event.data instanceof Blob) {
				incomingFileBlobUrl = URL.createObjectURL(event.data);
				
				if (incomingFileIsImage) {
					if (receivedImageElement) receivedImageElement.src = incomingFileBlobUrl;
					transitionState([recStateInitial], [recStateImageSuccess], 'flex');
					window.showToast('Imagen recibida exitosamente');
				} else {
					transitionState([recStateInitial], [recStateFileSuccess], 'flex');
					window.showToast('Archivo recibido exitosamente');
				}
				
				recWs?.close(); // Cerrar tras recibir binario
				return;
			}

			// Manejar recepción de JSON (Textos o Metadatos de archivo)
			try {
				const data = JSON.parse(event.data);
				if (data.action === 'text_received') {
					if (txtReceived) txtReceived.value = data.payload || '';
					transitionState([recStateInitial], [recStateSuccess], 'flex');
					window.showToast('Texto recibido exitosamente');
					recWs?.close(); // Cerrar al recibir texto
				} else if (data.action === 'file_received') {
					// Guardamos metadatos y esperamos el Blob en el siguiente frame
					incomingFileName = data.filename || 'archivo_recibido';
					
					// Detección simple si es imagen basada en extensión
					const lowerName = incomingFileName.toLowerCase();
					incomingFileIsImage = lowerName.endsWith('.png') || lowerName.endsWith('.jpg') || 
										lowerName.endsWith('.jpeg') || lowerName.endsWith('.gif') || 
										lowerName.endsWith('.webp');

					if (lblReceivedFileName) lblReceivedFileName.textContent = incomingFileName;
				} else if (data.action === 'error') {
					window.showToast(data.message || 'Código incorrecto', 'error');
					btnReceive.disabled = false;
				}
			} catch(e) {}
		};
		
		recWs.onerror = () => {
			window.showToast('Error de conexión con el servidor.', 'error');
			btnReceive.disabled = false;
		};
	});

	btnCopy?.addEventListener('click', async () => {
		try {
			if (txtReceived) {
				await navigator.clipboard.writeText(txtReceived.value);
				window.showToast('¡Copiado al portapapeles!');
				btnCopy.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> ¡Copiado!';
				setTimeout(() => {
					btnCopy.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg> Copiar texto';
				}, 2000);
			}
		} catch (err) {
			console.error('Error al copiar: ', err);
		}
	});

	const triggerDownload = (url: string, name: string) => {
		if (!url) return;
		const a = document.createElement('a');
		a.href = url;
		a.download = name;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
	};

	btnDownloadFile?.addEventListener('click', () => triggerDownload(incomingFileBlobUrl, incomingFileName));
	btnDownloadImage?.addEventListener('click', () => triggerDownload(incomingFileBlobUrl, incomingFileName));

	btnCopyImage?.addEventListener('click', async () => {
		try {
			if (!incomingFileBlobUrl) return;
			// Obtener el blob real desde la URL para el ClipboardItem
			const response = await fetch(incomingFileBlobUrl);
			const blob = await response.blob();
			
			await navigator.clipboard.write([
				new ClipboardItem({
					[blob.type]: blob
				})
			]);
			
			window.showToast('¡Imagen copiada al portapapeles!');
		} catch (err) {
			console.error('Error al copiar imagen: ', err);
			window.showToast('Error al copiar imagen (El navegador puede no soportarlo)', 'error');
		}
	});

	btnRecAnother?.addEventListener('click', resetReceiveView);
	btnRecAnotherFile?.addEventListener('click', resetReceiveView);
	btnRecAnotherImage?.addEventListener('click', resetReceiveView);

</script>
