---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LocalDrop">
	<div class="bg-bg-secondary rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col mt-8 max-w-xl mx-auto w-full">
		<!-- Tabs -->
		<div class="flex border-b border-slate-200">
			<button 
				id="tab-send"
				class="flex-1 py-4 text-center font-medium transition-colors bg-white text-primary border-b-2 border-primary"
			>
				Enviar
			</button>
			<button 
				id="tab-receive"
				class="flex-1 py-4 text-center font-medium transition-colors text-text-secondary hover:bg-slate-50 border-b-2 border-transparent"
			>
				Recibir
			</button>
		</div>

		<div class="p-6 md:p-8">
			<!-- Vista Enviar -->
			<div id="view-send" class="block">
				<!-- Estado: Formulario Inicial -->
				<div id="send-state-initial" class="space-y-4 block">
					<!-- Tabs Tipo de Envío -->
					<div class="flex bg-slate-100 rounded-md p-1 mb-4">
						<button id="send-type-text" class="flex-1 py-1.5 text-sm font-medium rounded bg-white shadow-sm text-text-main transition-all">Texto</button>
						<button id="send-type-file" class="flex-1 py-1.5 text-sm font-medium rounded text-text-secondary hover:text-text-main transition-all">Archivo</button>
					</div>

					<!-- Contenedor Texto -->
					<div id="text-container" class="space-y-2 block">
						<label for="text-to-send" class="block font-medium">Texto a enviar</label>
						<textarea 
							id="text-to-send" 
							rows="6" 
							class="w-full rounded-md border border-slate-300 p-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary resize-none"
							placeholder="Escribe o pega tu texto aquí..."
						></textarea>
					</div>

					<!-- Contenedor Archivo (Dropzone) -->
					<div id="file-container" class="hidden space-y-2">
						<label class="block font-medium">Archivo a enviar (Max 50MB)</label>
						
						<!-- Dropzone Area -->
						<div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-lg p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-slate-50 hover:border-primary transition-colors">
							<svg class="h-10 w-10 text-slate-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
							</svg>
							<p class="text-sm font-medium text-text-main">Haz clic para seleccionar o arrastra un archivo aquí</p>
							<p class="text-xs text-slate-500 mt-1">Soporta cualquier archivo (ej. PDF, JPG, ZIP)</p>
							<input type="file" id="file-input" class="hidden" accept="*" />
						</div>

						<!-- File Preview (Hidden by default) -->
						<div id="file-preview-container" class="hidden border border-slate-200 rounded-lg p-4 flex items-center justify-between bg-slate-50">
							<div class="flex items-center gap-3 overflow-hidden">
								<svg class="h-8 w-8 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
								</svg>
								<div class="min-w-0">
									<p id="file-name" class="text-sm font-medium text-text-main truncate">documento.pdf</p>
									<p id="file-size" class="text-xs text-slate-500">2.4 MB</p>
								</div>
							</div>
							<button id="btn-remove-file" class="text-slate-400 hover:text-error p-1 rounded transition-colors" title="Quitar archivo">
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
							</button>
						</div>
					</div>

					<button 
						id="btn-generate-pin"
						class="w-full bg-primary hover:bg-blue-900 text-white font-semibold py-3 px-4 rounded-md transition-colors disabled:opacity-50"
					>
						Generar PIN
					</button>
					<p id="send-error" class="text-error text-sm text-center hidden"></p>
				</div>

				<!-- Estado: Esperando Receptor -->
				<div id="send-state-waiting" class="hidden flex-col items-center justify-center py-6 text-center space-y-4">
					<p class="font-medium text-text-secondary">Código de seguridad</p>
					<div id="display-pin" class="text-6xl font-bold font-mono text-primary tracking-widest">----</div>
					<div class="flex items-center justify-center text-sm text-text-secondary gap-2 mt-4">
						<svg class="animate-spin h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
						Esperando al receptor...
					</div>
					<p class="text-xs text-text-secondary">Expira en 5 minutos</p>
					<button id="btn-cancel-send" class="mt-4 text-text-secondary text-sm hover:underline">Cancelar</button>
				</div>

				<!-- Estado: Transferencia Exitosa -->
				<div id="send-state-success" class="hidden flex-col items-center justify-center py-6 text-center space-y-4">
					<div class="h-16 w-16 bg-green-100 rounded-full flex items-center justify-center text-success mb-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
					</div>
					<h3 class="text-xl font-bold text-success">¡Transferencia completada!</h3>
					<p class="text-text-secondary">El texto ha sido recibido y borrado de la memoria.</p>
					<button id="btn-send-another" class="mt-6 w-full border border-primary text-primary font-semibold py-3 px-4 rounded-md hover:bg-slate-50 transition-colors">Enviar otro texto</button>
				</div>
			</div>

			<!-- Vista Recibir (Oculta inicialmente) -->
			<div id="view-receive" class="hidden">
				<!-- Estado: Ingresar PIN -->
				<div id="receive-state-initial" class="space-y-6 text-center block">
					<p class="font-medium text-text-secondary">Ingresa el código PIN para recibir el texto</p>
					<div class="flex justify-center gap-3 my-4">
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-300 rounded-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-300 rounded-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" disabled />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-300 rounded-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" disabled />
						<input type="text" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold font-mono border border-slate-300 rounded-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" disabled />
					</div>
					<p id="receive-error" class="text-error text-sm hidden"></p>
					<button 
						id="btn-receive-text"
						class="w-full bg-primary hover:bg-blue-900 text-white font-semibold py-3 px-4 rounded-md transition-colors disabled:opacity-50"
						disabled
					>
						Recibir Texto
					</button>
				</div>

				<!-- Estado: Texto Recibido -->
				<div id="receive-state-success" class="hidden flex-col space-y-4">
					<div class="flex items-center gap-2 text-success mb-2">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="font-medium">Texto recibido exitosamente</span>
					</div>
					<div class="relative">
						<textarea 
							id="received-text" 
							readonly
							rows="6" 
							class="w-full bg-slate-50 rounded-md border border-slate-300 p-3 outline-none resize-none text-text-main font-sans"
						></textarea>
					</div>
					<div class="flex gap-3 pt-2">
						<button 
							id="btn-copy-text"
							class="flex-1 bg-primary hover:bg-blue-900 text-white font-semibold py-3 px-4 rounded-md transition-colors flex items-center justify-center gap-2"
						>
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
							Copiar texto
						</button>
						<button id="btn-receive-another" class="flex-1 border border-slate-300 text-text-secondary font-semibold py-3 px-4 rounded-md hover:bg-slate-50 transition-colors">Volver</button>
					</div>
				</div>

				<!-- Estado: Archivo Recibido -->
				<div id="receive-state-file-success" class="hidden flex-col space-y-4">
					<div class="flex items-center gap-2 text-success mb-2">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span class="font-medium">Archivo listo para descargar</span>
					</div>
					<div class="border border-slate-200 rounded-lg p-4 flex items-center justify-between bg-white shadow-sm">
						<div class="flex items-center gap-3 overflow-hidden">
							<svg class="h-8 w-8 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
							</svg>
							<div class="min-w-0">
								<p id="received-file-name" class="text-sm font-medium text-text-main truncate">documento.pdf</p>
							</div>
						</div>
					</div>
					<div class="flex gap-3 pt-2">
						<button 
							id="btn-download-file"
							class="flex-1 bg-primary hover:bg-blue-900 text-white font-semibold py-3 px-4 rounded-md transition-colors flex items-center justify-center gap-2"
						>
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
							Descargar
						</button>
						<button id="btn-receive-another-file" class="flex-1 border border-slate-300 text-text-secondary font-semibold py-3 px-4 rounded-md hover:bg-slate-50 transition-colors">Volver</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	// ---------------------------------------------------------
	// 1. LÓGICA DE TABS (UI BASE)
	// ---------------------------------------------------------
	const tabSend = document.getElementById('tab-send');
	const tabReceive = document.getElementById('tab-receive');
	const viewSend = document.getElementById('view-send');
	const viewReceive = document.getElementById('view-receive');

	const setSendActive = () => {
		tabSend?.classList.add('bg-white', 'text-primary', 'border-primary');
		tabSend?.classList.remove('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		tabReceive?.classList.remove('bg-white', 'text-primary', 'border-primary');
		tabReceive?.classList.add('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		viewSend?.classList.remove('hidden');
		viewSend?.classList.add('block');
		
		viewReceive?.classList.add('hidden');
		viewReceive?.classList.remove('block');
	};

	const setReceiveActive = () => {
		tabReceive?.classList.add('bg-white', 'text-primary', 'border-primary');
		tabReceive?.classList.remove('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		tabSend?.classList.remove('bg-white', 'text-primary', 'border-primary');
		tabSend?.classList.add('text-text-secondary', 'hover:bg-slate-50', 'border-transparent');
		
		viewReceive?.classList.remove('hidden');
		viewReceive?.classList.add('block');
		
		viewSend?.classList.add('hidden');
		viewSend?.classList.remove('block');
	};

	tabSend?.addEventListener('click', setSendActive);
	tabReceive?.addEventListener('click', setReceiveActive);

	// ---------------------------------------------------------
	// 2. LÓGICA DE WEBSOCKETS (VISTA ENVIAR)
	// ---------------------------------------------------------
	
	// Elementos UI de "Enviar"
	const stateInitial = document.getElementById('send-state-initial');
	const stateWaiting = document.getElementById('send-state-waiting');
	const stateSuccess = document.getElementById('send-state-success');
	
	const txtToSend = document.getElementById('text-to-send') as HTMLTextAreaElement;
	const btnGeneratePin = document.getElementById('btn-generate-pin') as HTMLButtonElement;
	const displayPin = document.getElementById('display-pin');
	const errorMsg = document.getElementById('send-error');
	
	const btnCancelSend = document.getElementById('btn-cancel-send');
	const btnSendAnother = document.getElementById('btn-send-another');

	// Elementos UI Tipo de Envío (Tabs internos)
	const btnSendTypeText = document.getElementById('send-type-text');
	const btnSendTypeFile = document.getElementById('send-type-file');
	const containerText = document.getElementById('text-container');
	const containerFile = document.getElementById('file-container');
	
	// Elementos UI Dropzone
	const dropzone = document.getElementById('dropzone');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;
	const filePreviewContainer = document.getElementById('file-preview-container');
	const lblFileName = document.getElementById('file-name');
	const lblFileSize = document.getElementById('file-size');
	const btnRemoveFile = document.getElementById('btn-remove-file');

	let ws: WebSocket | null = null;
	let currentSendMode: 'text' | 'file' = 'text';
	let selectedFile: File | null = null;
	const MAX_FILE_SIZE = 50 * 1024 * 1024; // 50MB

	// --- Lógica de Tabs internos ---
	btnSendTypeText?.addEventListener('click', () => {
		currentSendMode = 'text';
		btnSendTypeText.classList.replace('text-text-secondary', 'text-text-main');
		btnSendTypeText.classList.replace('hover:text-text-main', 'bg-white');
		btnSendTypeText.classList.add('shadow-sm');
		
		btnSendTypeFile?.classList.replace('text-text-main', 'text-text-secondary');
		btnSendTypeFile?.classList.replace('bg-white', 'hover:text-text-main');
		btnSendTypeFile?.classList.remove('shadow-sm');

		containerText?.classList.replace('hidden', 'block');
		containerFile?.classList.replace('block', 'hidden');
		if(errorMsg) errorMsg.classList.add('hidden');
	});

	btnSendTypeFile?.addEventListener('click', () => {
		currentSendMode = 'file';
		btnSendTypeFile.classList.replace('text-text-secondary', 'text-text-main');
		btnSendTypeFile.classList.replace('hover:text-text-main', 'bg-white');
		btnSendTypeFile.classList.add('shadow-sm');
		
		btnSendTypeText?.classList.replace('text-text-main', 'text-text-secondary');
		btnSendTypeText?.classList.replace('bg-white', 'hover:text-text-main');
		btnSendTypeText?.classList.remove('shadow-sm');

		containerFile?.classList.replace('hidden', 'block');
		containerText?.classList.replace('block', 'hidden');
		if(errorMsg) errorMsg.classList.add('hidden');
	});

	// --- Lógica Dropzone y Archivos ---
	const formatBytes = (bytes: number, decimals = 2) => {
		if (!+bytes) return '0 Bytes';
		const k = 1024;
		const dm = decimals < 0 ? 0 : decimals;
		const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
	};

	const handleFileSelection = (file: File) => {
		if (file.size > MAX_FILE_SIZE) {
			showError(`El archivo es muy grande (${formatBytes(file.size)}). El máximo es 50MB.`);
			return;
		}
		selectedFile = file;
		if (lblFileName) lblFileName.textContent = file.name;
		if (lblFileSize) lblFileSize.textContent = formatBytes(file.size);
		
		dropzone?.classList.replace('flex', 'hidden');
		filePreviewContainer?.classList.replace('hidden', 'flex');
		if(errorMsg) errorMsg.classList.add('hidden');
	};

	const removeFile = () => {
		selectedFile = null;
		if (fileInput) fileInput.value = '';
		filePreviewContainer?.classList.replace('flex', 'hidden');
		dropzone?.classList.replace('hidden', 'flex');
	};

	dropzone?.addEventListener('click', () => fileInput?.click());
	btnRemoveFile?.addEventListener('click', removeFile);

	fileInput?.addEventListener('change', (e) => {
		const target = e.target as HTMLInputElement;
		if (target.files && target.files.length > 0) {
			handleFileSelection(target.files[0]);
		}
	});

	// Drag & Drop
	['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
		dropzone?.addEventListener(eventName, (e) => {
			e.preventDefault();
			e.stopPropagation();
		});
	});

	['dragenter', 'dragover'].forEach(eventName => {
		dropzone?.addEventListener(eventName, () => {
			dropzone?.classList.add('border-primary', 'bg-slate-50');
		});
	});

	['dragleave', 'drop'].forEach(eventName => {
		dropzone?.addEventListener(eventName, () => {
			dropzone?.classList.remove('border-primary', 'bg-slate-50');
		});
	});

	dropzone?.addEventListener('drop', (e: DragEvent) => {
		if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
			handleFileSelection(e.dataTransfer.files[0]);
		}
	});

	// Paste support anywhere in the window
	window.addEventListener('paste', (e: ClipboardEvent) => {
		// Only capture paste if we are in Send mode and the initial form is visible
		if (currentSendMode !== 'file' || !stateInitial?.classList.contains('block')) return;
		
		if (e.clipboardData && e.clipboardData.files && e.clipboardData.files.length > 0) {
			handleFileSelection(e.clipboardData.files[0]);
		}
	});

	// --- Flujo Principal de Envío ---
	const resetSendView = () => {
		if (ws) {
			ws.close();
			ws = null;
		}
		txtToSend.value = '';
		removeFile();
		if(errorMsg) errorMsg.classList.add('hidden');
		btnGeneratePin.disabled = false;
		
		stateInitial?.classList.remove('hidden');
		stateInitial?.classList.add('block');
		
		stateWaiting?.classList.remove('flex');
		stateWaiting?.classList.add('hidden');
		
		stateSuccess?.classList.remove('flex');
		stateSuccess?.classList.add('hidden');
	};

	const showWaitingState = (pin: string) => {
		if(displayPin) displayPin.textContent = pin;
		
		stateInitial?.classList.add('hidden');
		stateInitial?.classList.remove('block');
		
		stateWaiting?.classList.remove('hidden');
		stateWaiting?.classList.add('flex');
	};

	const showSuccessState = () => {
		if (ws) {
			ws.close();
			ws = null;
		}
		stateWaiting?.classList.add('hidden');
		stateWaiting?.classList.remove('flex');
		
		stateSuccess?.classList.remove('hidden');
		stateSuccess?.classList.add('flex');
	};

	const showError = (msg: string) => {
		if(errorMsg) {
			errorMsg.textContent = msg;
			errorMsg.classList.remove('hidden');
		}
		btnGeneratePin.disabled = false;
	};

	btnGeneratePin?.addEventListener('click', () => {
		if (currentSendMode === 'text') {
			const text = txtToSend.value.trim();
			if (!text) {
				showError('El texto no puede estar vacío');
				return;
			}
		} else {
			if (!selectedFile) {
				showError('Debes seleccionar un archivo primero');
				return;
			}
		}

		if(errorMsg) errorMsg.classList.add('hidden');
		btnGeneratePin.disabled = true;

		// Conectar al WebSocket proxificado por Vite/Astro para evitar problemas con Ngrok
		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const host = window.location.host; // Usa el host actual (ej. de ngrok)
		ws = new WebSocket(`${protocol}//${host}/ws`);
		ws.binaryType = 'arraybuffer'; // Importante para enviar archivos

		ws.onopen = () => {
			if (currentSendMode === 'text') {
				ws?.send(JSON.stringify({
					action: 'send_text',
					payload: txtToSend.value.trim()
				}));
			} else if (currentSendMode === 'file' && selectedFile) {
				ws?.send(JSON.stringify({
					action: 'send_file',
					filename: selectedFile.name
				}));
			}
		};

		ws.onmessage = (event) => {
			try {
				const data = JSON.parse(event.data);
				
				if (data.action === 'ready_for_binary') {
					// El servidor está listo para recibir el archivo binario
					if (selectedFile && ws) {
						ws.send(selectedFile);
					}
				} else if (data.action === 'pin_generated') {
					showWaitingState(data.pin);
				} else if (data.action === 'transfer_complete') {
					showSuccessState();
				} else if (data.action === 'error') {
					showError(data.message || 'Error desconocido');
					resetSendView();
				}
			} catch (e) {
				console.error("Error parseando mensaje WS", e);
			}
		};

		ws.onerror = (error) => {
			console.error("WebSocket Error:", error);
			showError('No se pudo conectar al servidor local.');
			resetSendView();
		};
	});

	btnCancelSend?.addEventListener('click', resetSendView);
	btnSendAnother?.addEventListener('click', resetSendView);

	// ---------------------------------------------------------
	// 3. LÓGICA DE WEBSOCKETS (VISTA RECIBIR)
	// ---------------------------------------------------------
	const recStateInitial = document.getElementById('receive-state-initial');
	const recStateSuccess = document.getElementById('receive-state-success');
	const pinInputs = document.querySelectorAll('.pin-input') as NodeListOf<HTMLInputElement>;
	const btnReceive = document.getElementById('btn-receive-text') as HTMLButtonElement;
	const recErrorMsg = document.getElementById('receive-error');
	const txtReceived = document.getElementById('received-text') as HTMLTextAreaElement;
	const btnCopy = document.getElementById('btn-copy-text') as HTMLButtonElement;
	const btnRecAnother = document.getElementById('btn-receive-another');
	
	// Elementos para Archivos
	const recStateFileSuccess = document.getElementById('receive-state-file-success');
	const lblReceivedFileName = document.getElementById('received-file-name');
	const btnDownloadFile = document.getElementById('btn-download-file');
	const btnRecAnotherFile = document.getElementById('btn-receive-another-file');

	let recWs: WebSocket | null = null;
	let incomingFileName = '';
	let incomingFileBlobUrl = '';
	
	// Auto-focus logic for PIN inputs
	pinInputs.forEach((input, index) => {
		input.addEventListener('input', (e) => {
			const val = (e.target as HTMLInputElement).value;
			// Solo permitir números
			if (!/^\d*$/.test(val)) {
				input.value = '';
				return;
			}
			if (val && index < pinInputs.length - 1) {
				pinInputs[index + 1].disabled = false;
				pinInputs[index + 1].focus();
			}
			checkPinComplete();
		});
		
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Backspace' && !input.value && index > 0) {
				pinInputs[index - 1].focus();
				pinInputs[index - 1].value = '';
				checkPinComplete();
			}
		});
	});

	const checkPinComplete = () => {
		const pin = Array.from(pinInputs).map(i => i.value).join('');
		if (btnReceive) btnReceive.disabled = pin.length !== 4;
		if(recErrorMsg) recErrorMsg.classList.add('hidden');
	};

	const resetReceiveView = () => {
		if (recWs) {
			recWs.close();
			recWs = null;
		}
		pinInputs.forEach((i, idx) => {
			i.value = '';
			i.disabled = idx !== 0;
		});
		if (txtReceived) txtReceived.value = '';
		if (btnCopy) btnCopy.innerHTML = '<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg> Copiar texto';
		
		// Reset File states
		if (incomingFileBlobUrl) {
			URL.revokeObjectURL(incomingFileBlobUrl);
			incomingFileBlobUrl = '';
		}
		incomingFileName = '';

		checkPinComplete();
		
		recStateSuccess?.classList.add('hidden');
		recStateSuccess?.classList.remove('flex');
		recStateFileSuccess?.classList.add('hidden');
		recStateFileSuccess?.classList.remove('flex');
		
		recStateInitial?.classList.remove('hidden');
		recStateInitial?.classList.add('block');
		pinInputs[0]?.focus();
	};

	btnReceive?.addEventListener('click', () => {
		const pin = Array.from(pinInputs).map(i => i.value).join('');
		if (pin.length !== 4) return;
		
		btnReceive.disabled = true;
		if(recErrorMsg) recErrorMsg.classList.add('hidden');
		
		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const host = window.location.host;
		recWs = new WebSocket(`${protocol}//${host}/ws`);
		recWs.binaryType = 'blob'; // Prepara para recibir archivos
		
		recWs.onopen = () => {
			recWs?.send(JSON.stringify({
				action: 'receive_text',
				pin: pin
			}));
		};
		
		recWs.onmessage = (event) => {
			// Manejar recepción de Binarios (Archivos)
			if (event.data instanceof Blob) {
				incomingFileBlobUrl = URL.createObjectURL(event.data);
				
				recStateInitial?.classList.add('hidden');
				recStateInitial?.classList.remove('block');
				recStateFileSuccess?.classList.remove('hidden');
				recStateFileSuccess?.classList.add('flex');
				
				recWs?.close(); // Cerrar tras recibir binario
				return;
			}

			// Manejar recepción de JSON (Textos o Metadatos de archivo)
			try {
				const data = JSON.parse(event.data);
				if (data.action === 'text_received') {
					if (txtReceived) txtReceived.value = data.payload || '';
					recStateInitial?.classList.add('hidden');
					recStateInitial?.classList.remove('block');
					recStateSuccess?.classList.remove('hidden');
					recStateSuccess?.classList.add('flex');
					recWs?.close(); // Cerrar al recibir texto
				} else if (data.action === 'file_received') {
					// Guardamos metadatos y esperamos el Blob en el siguiente frame
					incomingFileName = data.filename || 'archivo_recibido';
					if (lblReceivedFileName) lblReceivedFileName.textContent = incomingFileName;
				} else if (data.action === 'error') {
					if(recErrorMsg) {
						recErrorMsg.textContent = data.message || 'Código incorrecto';
						recErrorMsg.classList.remove('hidden');
					}
					btnReceive.disabled = false;
				}
			} catch(e) {}
		};
		
		recWs.onerror = () => {
			if(recErrorMsg) {
				recErrorMsg.textContent = 'Error de conexión con el servidor.';
				recErrorMsg.classList.remove('hidden');
			}
			btnReceive.disabled = false;
		};
	});

	btnCopy?.addEventListener('click', async () => {
		try {
			if (txtReceived) {
				await navigator.clipboard.writeText(txtReceived.value);
				btnCopy.innerHTML = '<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> ¡Copiado!';
				setTimeout(() => {
					btnCopy.innerHTML = '<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg> Copiar texto';
				}, 2000);
			}
		} catch (err) {
			console.error('Error al copiar: ', err);
		}
	});

	btnDownloadFile?.addEventListener('click', () => {
		if (!incomingFileBlobUrl) return;
		const a = document.createElement('a');
		a.href = incomingFileBlobUrl;
		a.download = incomingFileName;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
	});

	btnRecAnother?.addEventListener('click', resetReceiveView);
	btnRecAnotherFile?.addEventListener('click', resetReceiveView);

</script>
