graph LR
    %% Definición de Estilos
    classDef skill fill:#f96,stroke:#333,stroke-width:2px;
    classDef agent fill:#dfd,stroke:#333,stroke-width:2px;
    classDef goal fill:#bbf,stroke:#333,stroke-width:1px;

    %% Agentes Principales
    subgraph Agents [Agentes Especializados]
        SW[spec-writer]
        BLD[build]
        TW[test-writer]
        SR[security-reviewer]
    end

    %% Skills y su Aplicación
    subgraph Skills [Skills de Soporte]
        CG((cost-guard))
        DM((definicion-de-marca))
        GS((generador-de-skills))
        SBP((seguridad-buenas-practicas))
        TS((test-strategy))
    end

    %% Relaciones de Influencia
    CG -- "Optimiza tokens en" --> SW
    CG -- "Optimiza tokens en" --> BLD
    CG -- "Optimiza tokens en" --> TW
    CG -- "Optimiza tokens en" --> SR

    DM -- "Diseño visual para" --> SW
    
    TS -- "Estrategia para" --> TW
    
    SBP -- "Checklist para" --> SR
    SBP -- "Valida" --> GS

    GS -- "Crea nuevas" --> Skills

    %% Flujo de Valor
    SW -- "Genera Specs" --> BLD
    BLD -- "Genera Código" --> TW
    TW -- "Genera Confianza" --> SR
    SR -- "Genera Seguridad" --> Final[Producto Final]

    %% Asignación de Clases
    class SW,BLD,TW,SR agent;
    class CG,DM,GS,SBP,TS skill;
    class Final goal;
