{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.1-pro-preview",

  "instructions": [
    "AGENTS.md",
    "specs/mission.md",
    "specs/tech-stack.md"
  ],

  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "rm -rf*": "deny",
      "*": "ask"
    }
  },

  "agent": {
    "plan": {
      "model": "google/gemini-3-flash-preview"
    },
    "build": {
      "model": "google/gemini-3.1-pro-preview",
      "permission": {
        "edit": "allow",
        "bash": { "*": "ask", "git *": "allow", "npm *": "allow" }
      }
    },



    "spec-writer": {
      "mode": "subagent",
      "description": "Redacta constitution y specs de feature; NUNCA implementa código.",
      "model": "google/gemini-3.1-pro-preview",
      "tools": { "write": true, "edit": true, "bash": false, "webfetch": false }
    },

    "test-writer": {
      "mode": "subagent",
      "description": "Escribe y corre tests a partir de requirements.md/validation.md.",
      "model": "google/gemini-3-flash-preview",
      "tools": { "write": true, "edit": true, "bash": true, "webfetch": false },
      "permission": {
        "edit": "allow",
        "bash": { "npm test*": "allow", "npm run test*": "allow", "*": "ask" }
      }
    },

    "security-reviewer": {
      "mode": "subagent",
      "description": "Revisión de seguridad de solo lectura (OWASP, secrets, authZ/authN).",
      "model": "google/gemini-3.1-pro-preview",
      "tools": { "write": false, "edit": false, "bash": false, "webfetch": false }
    },

    "code-reviewer": {
      "mode": "subagent",
      "description": "Revisión de calidad de código de solo lectura, sin editar.",
      "model": "google/gemini-3-flash-preview",
      "tools": { "write": false, "edit": false, "bash": false, "webfetch": false }
    }
  }
}
